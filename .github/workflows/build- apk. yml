# Builds the Daily Life App APK on GitHub's runners.
# Why CI: the agent VM cannot run Gradle (its Java loopback IPC is
# broken at platform level — see toolchain/NOTES.md). CI runners
# build the identical project with no local installs needed.
#
# Use: push this repo to GitHub (private is fine), open the Actions
# tab, run "Build APK" (or push to main). Download the APK from the
# run's Artifacts section and install it on the phone.
name: Build APK

on:
  workflow_dispatch:
  push:
    branches: [main]

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: "17"

      - uses: subosito/flutter-action@v2
        with:
          channel: stable
          cache: true

      - name: Install dependencies
        run: flutter pub get

      - name: Analyze
        run: flutter analyze

      - name: Test
        run: flutter test

      - name: Build release APK
        run: flutter build apk --release

      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: daily-life-app-release-apk
          path: build/app/outputs/flutter-apk/app-release.apk
          retention
-days: 30
